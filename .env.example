# Copy this file to .env and fill in your values:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# Never commit .env (it holds the OAuth client secret, the storage connection string and webhook secrets).
# It is in .gitignore and .dockerignore.

# ---------------------------------------------------------------------------
# ServiceNow (REQUIRED)
# ---------------------------------------------------------------------------
# Instance name only: for https://acmecorp.service-now.com use acmecorp
SN_INSTANCE=yourinstance

# OAuth 2.0 client credentials (the only login supported). Create the OAuth application in ServiceNow
# (README section 2). The application runs as the read-only service account.
SN_CLIENT_ID=
SN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Azure Storage (REQUIRED) - where incidents.json, swat_status.json and swat_details/ are stored
# ---------------------------------------------------------------------------
# Connection string of the storage account. It contains the account key, so treat it like a password.
# Get it in the Azure portal: Storage account > Security + networking > Access keys > Connection string.
# Never commit it. In Azure Container Apps, store it as a secret (README section 14).
# Format: DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# Blob container and the folder inside it that holds the data files. Both are created automatically if missing.
AZURE_STORAGE_CONTAINER=p1-api-monitor
AZURE_STORAGE_FOLDER=p1-api-monitor

# ---------------------------------------------------------------------------
# Teams alerts (OPTIONAL - leave empty to turn off)
# ---------------------------------------------------------------------------
# Power Automate webhook URL(s), comma separated. Every alert is sent to all of them.
TEAMS_WEBHOOK_URLS=

# Set to false ONLY if a corporate TLS proxy breaks the Teams call and you cannot install its CA.
TEAMS_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Email alerts over SMTP (OPTIONAL - leave EMAIL_TO empty to turn off)
# ---------------------------------------------------------------------------
# Comma separated addresses or a distribution list address
EMAIL_TO=
EMAIL_CC=
EMAIL_BCC=

SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown on the email (defaults to SMTP_USER)
SMTP_FROM=

# ---------------------------------------------------------------------------
# Monitor schedule
# ---------------------------------------------------------------------------
# Minutes between checks. Default 15.
MONITOR_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# SWAT board (served on port 8080 in the container, mapped to the same port on the host)
# ---------------------------------------------------------------------------
SWAT_BOARD_ENABLED=true
SWAT_BOARD_PORT=8080

# The address SWAT teams open from the "Open SWAT board" button in Teams cards.
# Must be an address the Teams users can reach, for example http://myserver.company.com:8080
# Leave empty to use the default built into the image (http://localhost:8080 unless you built it with
# --build-arg SWAT_BOARD_PUBLIC_URL=... ). With docker compose, a value here is also used when building.
SWAT_BOARD_PUBLIC_URL=
