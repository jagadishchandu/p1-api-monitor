# Copy this file to .env and fill in your values:
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
# Each setting has an example line above it. Examples are for guidance only: replace them with your own values,
# and leave a setting empty when it is not needed.
# Never commit .env (it holds the OAuth client secret and webhook secrets. It holds no storage key).
# It is in .gitignore and .dockerignore.

# ---------------------------------------------------------------------------
# ServiceNow (REQUIRED)
# ---------------------------------------------------------------------------
# Instance name only, without https:// or .service-now.com
# Example: acmecorp   (for https://acmecorp.service-now.com)
SN_INSTANCE=yourinstance

# OAuth 2.0 client credentials (the only login supported). Create the OAuth application in ServiceNow
# (README section 2). The application runs as the read-only service account.
# Example: 4f1c2a9e0b7d4c3a8e6f5d2b1a0c9e8f   (the Client ID from ServiceNow)
SN_CLIENT_ID=
# Example: a long random string copied from ServiceNow   (the Client Secret; keep it private)
SN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Azure Storage (REQUIRED) - where incidents.json, swat_status.json and swat_details/ are stored
# ---------------------------------------------------------------------------
# URL of the storage account. It is not a secret: the app signs in with its managed identity, not a key.
# Get it in the Azure portal: Storage account > Overview > Primary endpoints > Blob service.
# Needs the Storage Blob Data Contributor role (README section 6).
# Example: https://stp1apimonjc01.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_URL=

# Blob container that holds the data files. Created automatically if missing.
# Example: p1-api-monitor
AZURE_STORAGE_CONTAINER=p1-api-monitor

# Folder inside the container for incidents.json, swat_status.json and swat_details/. Created automatically if missing.
# Example: p1-api-monitor-test   (use a different folder for test and production)
AZURE_STORAGE_FOLDER=p1-api-monitor

# ---------------------------------------------------------------------------
# Teams alerts (OPTIONAL - leave empty to turn off)
# ---------------------------------------------------------------------------
# Power Automate webhook URL(s), comma separated. Every alert is sent to all of them.
# Example: https://prod-00.westus.logic.azure.com:443/workflows/abc123/triggers/manual/paths/invoke?sig=xyz
TEAMS_WEBHOOK_URLS=

# Set to false ONLY if a corporate TLS proxy breaks the Teams call and you cannot install its CA.
# Example: true
TEAMS_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Email alerts over SMTP (OPTIONAL - leave EMAIL_TO empty to turn off)
# ---------------------------------------------------------------------------
# Comma separated addresses or a distribution list address
# Example: p1-oncall@company.com,swat-leads@company.com
EMAIL_TO=
# Example: manager@company.com
EMAIL_CC=
# Example: audit-mailbox@company.com
EMAIL_BCC=

# SMTP server host name
# Example: smtp.company.com
SMTP_HOST=
# Example: 587   (usually 587 with STARTTLS, or 25 for an internal relay)
SMTP_PORT=587
# Example: true
SMTP_STARTTLS=true
# SMTP login. Leave empty for an internal relay that needs no login.
# Example: svc_p1_mail
SMTP_USER=
# Example: the SMTP password from your mail team
SMTP_PASSWORD=
# Sender address shown on the email (defaults to SMTP_USER)
# Example: p1-monitor@company.com
SMTP_FROM=

# ---------------------------------------------------------------------------
# Monitor schedule
# ---------------------------------------------------------------------------
# Minutes between checks. Default 15.
# Example: 15
MONITOR_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# SWAT board (served on port 8080 in the container, mapped to the same port on the host)
# ---------------------------------------------------------------------------
# Turn the SWAT board on or off.
# Example: true
SWAT_BOARD_ENABLED=true
# Port the board listens on inside the container. Keep 8080 unless you also change the port mapping.
# Example: 8080
SWAT_BOARD_PORT=8080

# The address SWAT teams open from the "Open SWAT board" button in Teams cards.
# Must be an address the Teams users can reach. Include the port.
# Example: http://myserver.company.com:8080   or   https://p1-api-monitor.<region>.azurecontainerapps.io
# Leave empty to use the default built into the image (http://localhost:8080 unless you built it with
# --build-arg SWAT_BOARD_PUBLIC_URL=... ). With docker compose, a value here is also used when building.
SWAT_BOARD_PUBLIC_URL=
